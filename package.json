{
  "name": "irisport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1438 --strictPort",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "bash scripts/prepare-hook.sh && PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "tauri:build": "bash scripts/prepare-hook.sh && PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --bundles app",
    "icon": "node scripts/make-icon.mjs && tauri icon src-tauri/icons/icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5",
    "typescript": "^5",
    "vite": "^6"
  }
}
