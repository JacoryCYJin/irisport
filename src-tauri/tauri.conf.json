{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Irisport",
  "version": "0.1.0",
  "identifier": "com.jacoryspace.irisport",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1438",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Irisport",
        "width": 360,
        "height": 480,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": ["bin/irisport-hook"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
